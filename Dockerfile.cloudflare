FROM node:24.14.0-bookworm-slim AS dependencies
WORKDIR /runtime
COPY .cloudflare/runtime/package.json .cloudflare/runtime/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM node:24.14.0-bookworm-slim
WORKDIR /app
COPY --from=dependencies /runtime/node_modules ./node_modules
COPY --chown=node:node package.json ./package.json
COPY --chown=node:node server ./server
COPY --chown=node:node src ./src
COPY --chown=node:node config ./config
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node .cloudflare/runtime/server.mjs .cloudflare/runtime/build-info.json ./.cloudflare/runtime/
RUN mkdir -p .gev-cache .gev-logs && chown node:node .gev-cache .gev-logs
ENV HOST=0.0.0.0 PORT=4173 NODE_ENV=production NODE_OPTIONS=--max-old-space-size=512
USER node
EXPOSE 4173
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD node -e "fetch('http://127.0.0.1:4173/__health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", ".cloudflare/runtime/server.mjs"]
