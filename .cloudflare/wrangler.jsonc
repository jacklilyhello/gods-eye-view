{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gods-eye-view",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "gods.lily.lat", "custom_domain": true }],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
  },
  "containers": [
    {
      "class_name": "GodsEyeViewContainer",
      "image": "../Dockerfile.cloudflare",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GODS_EYE",
        "class_name": "GodsEyeViewContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GodsEyeViewContainer"],
    },
  ],
}
